execute_process(COMMAND "${MAM}" --build-info RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 10)
if(NOT result EQUAL 0 OR NOT errors STREQUAL "")
    message(FATAL_ERROR "Build identity must be pure JSON without device/banner output: ${result}\n${errors}")
endif()
string(JSON version GET "${output}" version)
string(JSON standard GET "${output}" cxx_standard)
string(JSON compiler GET "${output}" compiler_id)
string(JSON revision GET "${output}" git_revision)
string(JSON build_type GET "${output}" build_type)
if(NOT version STREQUAL "${VERSION}" OR NOT standard EQUAL 20 OR compiler STREQUAL "" OR build_type STREQUAL "")
    message(FATAL_ERROR "Incomplete or inconsistent build identity: ${output}")
endif()
if(NOT revision STREQUAL "unknown" AND NOT revision MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "Malformed Git revision: ${revision}")
endif()
