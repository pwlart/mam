if(NOT DEFINED MAM OR NOT DEFINED WORK)
  message(FATAL_ERROR "MAM and WORK are required")
endif()
file(MAKE_DIRECTORY "${WORK}")
foreach(seed IN ITEMS 12 13)
  file(WRITE "${WORK}/rack-${seed}.json" "{\"kind\":\"rack\",\"version\":1,\"sampleRate\":48000,\"channels\":2,\"randomSeed\":${seed},\"nodes\":[{\"id\":\"noise\",\"type\":\"mam_chip\",\"params\":{\"noiseMix\":0.8,\"gain\":0.2}}],\"commands\":[{\"sampleTime\":0,\"nodeId\":\"noise\",\"type\":\"Trigger\",\"value\":1}]}")
  file(WRITE "${WORK}/session-${seed}.json" "{\"kind\":\"session\",\"version\":1,\"sampleRate\":48000,\"channels\":2,\"racks\":[{\"id\":\"alpha\",\"path\":\"rack-${seed}.json\"}]}")
endforeach()

function(render name route input)
  set(output "${WORK}/${name}.wav")
  file(REMOVE "${output}")
  execute_process(COMMAND "${MAM}" "${route}" "${input}" --wav "${output}"
      --sr 48000 --duration 0.05 --no-progress --no-summary ${ARGN}
      RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 20)
  if(NOT result EQUAL 0 OR NOT EXISTS "${output}")
    message(FATAL_ERROR "${name} failed (${result}): ${stdout}\n${stderr}")
  endif()
  file(SIZE "${output}" bytes)
  if(bytes LESS 1000)
    message(FATAL_ERROR "${name} produced incomplete audio")
  endif()
  file(SHA256 "${output}" hash)
  set(${name} "${hash}" PARENT_SCOPE)
endfunction()

foreach(mode IN ITEMS rack session)
  render(json12 --${mode} "${WORK}/${mode}-12.json")
  render(json13 --${mode} "${WORK}/${mode}-13.json")
  render(repeat12 --${mode} "${WORK}/${mode}-12.json")
  render(override13 --${mode} "${WORK}/${mode}-12.json" --random-seed 13)
  render(zero --${mode} "${WORK}/${mode}-12.json" --random-seed 0)
  if(NOT json12 STREQUAL repeat12 OR NOT json12 STREQUAL zero)
    message(FATAL_ERROR "${mode}: repeat or zero-override did not retain JSON seed")
  endif()
  if(NOT json13 STREQUAL override13 OR json12 STREQUAL json13)
    message(FATAL_ERROR "${mode}: CLI precedence or audible seed selection is broken")
  endif()
endforeach()
