file(READ "${ROOT}/upstream.json" manifest)
string(JSON count LENGTH "${manifest}" files)
math(EXPR last "${count} - 1")
foreach(index RANGE 0 ${last})
    string(JSON name MEMBER "${manifest}" files ${index})
    string(JSON expected GET "${manifest}" files "${name}" sha256)
    file(SHA256 "${ROOT}/${name}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Vendored dependency file changed: ${name}")
    endif()
endforeach()
