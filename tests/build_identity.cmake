file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/source")
find_program(test_git git REQUIRED)

function(run_checked)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Command failed: ${ARGV}\n${output}\n${errors}")
    endif()
endfunction()

# Exercise a build-time target without needing another complete MAM build.
file(WRITE "${WORK}/source/CMakeLists.txt" "cmake_minimum_required(VERSION 3.21)\nproject(identity_fixture NONE)\nadd_custom_target(identity ALL COMMAND \"${CMAKE_COMMAND}\" -DSOURCE_DIR=\${CMAKE_CURRENT_SOURCE_DIR} -DOUTPUT=\${CMAKE_CURRENT_BINARY_DIR}/identity.hpp -DVERSION=0.0.1 -DCOMPILER_ID=test -DCOMPILER_VERSION=1 -DBUILD_TYPE=Debug -DASAN=OFF -DUBSAN=OFF -DTSAN=OFF -DLTO=OFF -P \"${GENERATOR_SCRIPT}\" VERBATIM)\n")
run_checked("${CMAKE_COMMAND}" -S "${WORK}/source" -B "${WORK}/build")
run_checked("${CMAKE_COMMAND}" --build "${WORK}/build")
file(READ "${WORK}/build/identity.hpp" unknown)
if(NOT unknown MATCHES "\"git_revision\" : \"unknown\"" OR NOT unknown MATCHES "\"git_dirty\" : null")
    message(FATAL_ERROR "Source without its own repository must report unknown, including inside a parent checkout")
endif()
run_checked("${test_git}" -C "${WORK}/source" init -q)
file(WRITE "${WORK}/source/tracked.txt" "first\n")
run_checked("${test_git}" -C "${WORK}/source" add CMakeLists.txt tracked.txt)
run_checked("${test_git}" -C "${WORK}/source" -c user.name=Test -c user.email=test@invalid -c commit.gpgsign=false -c core.hooksPath=/dev/null commit -qm first)
run_checked("${CMAKE_COMMAND}" --build "${WORK}/build")
execute_process(COMMAND "${test_git}" -C "${WORK}/source" rev-parse HEAD OUTPUT_VARIABLE first OUTPUT_STRIP_TRAILING_WHITESPACE)
file(READ "${WORK}/build/identity.hpp" first_header)
if(NOT first_header MATCHES "${first}" OR NOT first_header MATCHES "\"git_dirty\" : false")
    message(FATAL_ERROR "First clean commit not reflected by build-time identity")
endif()
file(WRITE "${WORK}/source/tracked.txt" "second\n")
run_checked("${CMAKE_COMMAND}" --build "${WORK}/build")
file(READ "${WORK}/build/identity.hpp" dirty_header)
if(NOT dirty_header MATCHES "\"git_dirty\" : true")
    message(FATAL_ERROR "Dirty source state not reflected")
endif()
run_checked("${test_git}" -C "${WORK}/source" add tracked.txt)
run_checked("${test_git}" -C "${WORK}/source" -c user.name=Test -c user.email=test@invalid -c commit.gpgsign=false -c core.hooksPath=/dev/null commit -qm second)
run_checked("${CMAKE_COMMAND}" --build "${WORK}/build")
execute_process(COMMAND "${test_git}" -C "${WORK}/source" rev-parse HEAD OUTPUT_VARIABLE second OUTPUT_STRIP_TRAILING_WHITESPACE)
file(READ "${WORK}/build/identity.hpp" second_header)
if(first STREQUAL second OR NOT second_header MATCHES "${second}" OR NOT second_header MATCHES "\"git_dirty\" : false")
    message(FATAL_ERROR "Commit changed without reconfiguration, but build identity did not")
endif()
file(SHA256 "${WORK}/build/identity.hpp" before)
run_checked("${CMAKE_COMMAND}" --build "${WORK}/build")
file(SHA256 "${WORK}/build/identity.hpp" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "Unchanged build identity is unstable")
endif()

# An exported subtree inside the new Git repository must not claim its HEAD.
file(MAKE_DIRECTORY "${WORK}/source/archive")
run_checked("${CMAKE_COMMAND}" -DSOURCE_DIR=${WORK}/source/archive -DOUTPUT=${WORK}/archive.hpp
    -DVERSION=0.0.1 -DCOMPILER_ID=test -DCOMPILER_VERSION=1 -DBUILD_TYPE=
    -DASAN=OFF -DUBSAN=OFF -DTSAN=OFF -DLTO=OFF -P "${GENERATOR_SCRIPT}")
file(READ "${WORK}/archive.hpp" archive_header)
if(NOT archive_header MATCHES "\"git_revision\" : \"unknown\"")
    message(FATAL_ERROR "Archive borrowed an ancestor repository's identity")
endif()
if(NOT archive_header MATCHES "\"build_type\" : \"unspecified\"")
    message(FATAL_ERROR "An unspecified build type must be reported explicitly")
endif()
