{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "C++20 development and tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "MAM_WARNINGS_AS_ERRORS": "ON",
        "MAM_USE_JSON_SCHEMA": "OFF",
        "BUILD_TESTING": "ON",
        "MAM_ENABLE_ASAN": "OFF",
        "MAM_ENABLE_UBSAN": "OFF",
        "MAM_ENABLE_LTO": "OFF",
        "MAM_ENABLE_PYTHON_TESTS": "OFF",
        "MAM_ENABLE_TSAN": "OFF"
      }
    },
    {
      "name": "asan",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MAM_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "ubsan",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build/ubsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MAM_ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MAM_ENABLE_LTO": "ON",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "python",
      "displayName": "Native and optional Python integration tests",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build/python",
      "cacheVariables": {
        "MAM_ENABLE_PYTHON_TESTS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "tsan",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build/tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MAM_ENABLE_TSAN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "ubsan",
      "configurePreset": "ubsan"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "python",
      "configurePreset": "python"
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 60
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 60
      }
    },
    {
      "name": "ubsan",
      "configurePreset": "ubsan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 60
      }
    },
    {
      "name": "python",
      "configurePreset": "python",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 240
      }
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 120
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 120
      }
    }
  ]
}
