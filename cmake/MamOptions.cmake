# One policy for libraries, executables, generators and regression tests.
add_library(mam_sanitizers INTERFACE)
if(MAM_ENABLE_TSAN AND (MAM_ENABLE_ASAN OR MAM_ENABLE_UBSAN OR MAM_ENABLE_LTO))
    message(FATAL_ERROR "ThreadSanitizer must use a separate build without ASan, UBSan or LTO")
endif()
if(MAM_ENABLE_ASAN OR MAM_ENABLE_UBSAN OR MAM_ENABLE_TSAN)
    if(NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang|GNU")
        message(FATAL_ERROR "The sanitizer presets require Clang or GCC")
    endif()
    target_compile_options(mam_sanitizers INTERFACE -fno-omit-frame-pointer)
endif()
if(MAM_ENABLE_TSAN)
    target_compile_options(mam_sanitizers INTERFACE -fsanitize=thread)
    target_link_options(mam_sanitizers INTERFACE -fsanitize=thread)
endif()
if(MAM_ENABLE_ASAN)
    target_compile_options(mam_sanitizers INTERFACE -fsanitize=address)
    target_link_options(mam_sanitizers INTERFACE -fsanitize=address)
endif()
if(MAM_ENABLE_UBSAN)
    target_compile_options(mam_sanitizers INTERFACE -fsanitize=undefined -fno-sanitize-recover=undefined)
    target_link_options(mam_sanitizers INTERFACE -fsanitize=undefined -fno-sanitize-recover=undefined)
endif()
if(MAM_ENABLE_LTO)
    include(CheckIPOSupported)
    check_ipo_supported(RESULT mam_ipo_supported OUTPUT mam_ipo_error)
    if(NOT mam_ipo_supported)
        message(FATAL_ERROR "LTO requested but unavailable: ${mam_ipo_error}")
    endif()
endif()

function(mam_configure_target target)
    target_compile_features(${target} PUBLIC cxx_std_20)
    target_link_libraries(${target} PUBLIC mam_sanitizers)
    target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic -Wconversion -Wshadow)
    if(MAM_WARNINGS_AS_ERRORS)
        target_compile_options(${target} PRIVATE -Werror)
    endif()
    if(MAM_ENABLE_LTO)
        set_property(TARGET ${target} PROPERTY INTERPROCEDURAL_OPTIMIZATION TRUE)
    endif()
endfunction()
