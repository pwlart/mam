# Runs at build time, including builds after a commit with no reconfigure.
foreach(required IN ITEMS SOURCE_DIR OUTPUT VERSION COMPILER_ID COMPILER_VERSION BUILD_TYPE)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing build identity input: ${required}")
    endif()
endforeach()

set(revision "unknown")
set(dirty "null")
find_program(identity_git git)
if(identity_git)
    execute_process(COMMAND "${identity_git}" -C "${SOURCE_DIR}" rev-parse --show-toplevel
        RESULT_VARIABLE root_result OUTPUT_VARIABLE git_root ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
    file(REAL_PATH "${SOURCE_DIR}" source_real)
    if(root_result EQUAL 0)
        file(REAL_PATH "${git_root}" root_real)
        # An archive inside someone else's checkout must not borrow its identity.
        if(source_real STREQUAL root_real)
            execute_process(COMMAND "${identity_git}" -C "${SOURCE_DIR}" rev-parse --verify HEAD
                RESULT_VARIABLE revision_result OUTPUT_VARIABLE candidate ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
            if(revision_result EQUAL 0 AND candidate MATCHES "^[0-9a-f]+$")
                set(revision "${candidate}")
                execute_process(COMMAND "${identity_git}" -C "${SOURCE_DIR}" status --porcelain --untracked-files=normal
                    RESULT_VARIABLE status_result OUTPUT_VARIABLE status ERROR_QUIET)
                if(status_result EQUAL 0)
                    if(status STREQUAL "")
                        set(dirty "false")
                    else()
                        set(dirty "true")
                    endif()
                endif()
            endif()
        endif()
    endif()
endif()

set(identity "{}")
function(identity_string key value)
    string(REPLACE "\\" "\\\\" escaped "${value}")
    string(REPLACE "\"" "\\\"" escaped "${escaped}")
    string(REPLACE "\n" "\\n" escaped "${escaped}")
    string(REPLACE "\r" "\\r" escaped "${escaped}")
    string(REPLACE "\t" "\\t" escaped "${escaped}")
    string(JSON identity SET "${identity}" "${key}" "\"${escaped}\"")
    set(identity "${identity}" PARENT_SCOPE)
endfunction()
identity_string(version "${VERSION}")
identity_string(git_revision "${revision}")
identity_string(compiler_id "${COMPILER_ID}")
identity_string(compiler_version "${COMPILER_VERSION}")
if(BUILD_TYPE STREQUAL "")
    set(BUILD_TYPE "unspecified")
endif()
identity_string(build_type "${BUILD_TYPE}")
string(JSON identity SET "${identity}" schema_version 1)
string(JSON identity SET "${identity}" cxx_standard 20)
string(JSON identity SET "${identity}" git_dirty "${dirty}")
foreach(flag IN ITEMS ASAN UBSAN TSAN LTO)
    if(${flag})
        set(value true)
    else()
        set(value false)
    endif()
    string(TOLOWER "${flag}" name)
    string(JSON identity SET "${identity}" "${name}" "${value}")
endforeach()

# No timestamp: unchanged metadata must not force recompilation on every build.
get_filename_component(output_dir "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${output_dir}")
set(contents "#pragma once\ninline constexpr const char* mamBuildIdentity = R\"MAM_ID(${identity})MAM_ID\";\ninline constexpr const char* mamBuildVersion = \"${VERSION}\";\ninline constexpr const char* mamBuildRevision = \"${revision}\";\n")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" previous)
    if(previous STREQUAL contents)
        return()
    endif()
endif()
file(WRITE "${OUTPUT}" "${contents}")
